{
  "name": "cbt-annotation-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:local": "node local_server.mjs",
    "dev": "wrangler dev --port 8787",
    "test": "node --test tests/*.test.js",
    "check": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "db:migrate:remote": "wrangler d1 migrations apply cbt_annotation --remote",
    "db:seed:remote": "wrangler d1 execute cbt_annotation --remote --file ../data/seed.sql",
    "db:experts:remote": "wrangler d1 execute cbt_annotation --remote --file ../data/experts.sql"
  },
  "devDependencies": {
    "wrangler": "^4.54.0"
  }
}
